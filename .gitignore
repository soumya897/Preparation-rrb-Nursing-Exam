# ============================================
# Root Git Ignore for Preparation For Nursing Exam
# ============================================

# Environment variables & local configuration
.env
.env.*
*.env
!.env.example
application-local.yml
application-local.yaml
application-local.properties

# Backend build output & packages
target/
**/target/
*.jar
*.war
*.original

# Frontend dependencies & build output
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor files
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
